{
  "name": "syncw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Syncw (Synchronized World) - declarative multi-agent orchestration where agent behaviour, provider access, and model capability are three orthogonal, hot-swappable registries.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "syncw": "./src/cli.ts"
  },
  "scripts": {
    "syncw": "node src/cli.ts",
    "bind": "node src/cli.ts bind workflows/feature-dev.yaml",
    "run:hello": "node src/cli.ts run workflows/hello.yaml",
    "run:demo": "node src/cli.ts run workflows/feature-dev.yaml",
    "demo": "node scripts/demo.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run demo"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3"
  }
}
